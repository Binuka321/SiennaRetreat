# MongoDB connection configuration
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control

PORT=5000

# MongoDB Atlas SRV connection string
# Get your connection string from MongoDB Atlas:
# 1. In Atlas, click "Connect"
# 2. Choose "Drivers"
# 3. Copy the Node.js connection string (mongodb+srv://...)
# 4. Replace <username>, <password>, and database name as needed

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ptzaxpc.mongodb.net/sienna_portfolio?retryWrites=true&w=majority

# Optional: For local/alternate connections, use the long connection string format:
# MONGO_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/database?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority
